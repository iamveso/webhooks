{
  "transforms": [
    {
      "mode": "sql",
      "include": "**/*.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    }
  ],
  "srcDir": "./src/db/queries",
  "failOnError": true,
  "camelCaseColumnNames": false,
  "db": {
    "host": "localhost",
    "user": "postgres",
    "dbName": "postgres",
    "password": "password",
    "port": 5000,
    "ssl": false
  }
}
